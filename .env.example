# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Webhook Mode Configuration (leave WEBHOOK_URL empty for local Polling mode)
# e.g., WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=my_secret_token_123

# Server binding
HOST=0.0.0.0
PORT=8080

# Storage Configuration
DATABASE_PATH=data/autoreply.db
MEDIA_DIR=data/media

# Auto-reply cooldown in seconds (30 minutes default)
AUTO_REPLY_COOLDOWN=1800
